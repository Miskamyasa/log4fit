{
  "name": "log4fit",
  "type": "module",
  "url": "https://log4fit.com",
  "version": "1.0.48",
  "engines": {
    "node": ">=24.14.0"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build:all": "eas build --profile production --platform all --local",
    "publish:android": "eas update --channel production --platform android --auto",
    "publish:ios": "eas update --channel production --platform ios --auto",
    "start": "expo start",
    "dev": "./reset-watchman.sh && expo start --dev-client",
    "type-check": "tsc --noEmit",
    "lint": "eslint --cache",
    "lint:fix": "eslint --fix",
    "lint:sarif": "eslint ./src --format @microsoft/eslint-formatter-sarif --output-file eslint-results.sarif"
  },
  "dependencies": {
    "@babel/core": "7.27.7",
    "@babel/preset-env": "7.27.2",
    "@clerk/expo": "3.0.1",
    "@expo/vector-icons": "15.1.1",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@miskamyasa/eslint-config": "1.0.2",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/native": "7.1.14",
    "@react-navigation/native-stack": "7.3.21",
    "@shopify/flash-list": "2.0.2",
    "@types/i18n-js": "3.8.8",
    "@types/lodash": "4.17.19",
    "@types/node": "20.16.10",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "babel-preset-expo": "55.0.22",
    "eslint": "9.39.4",
    "expo": "^55.0.26",
    "expo-apple-authentication": "55.0.13",
    "expo-application": "55.0.15",
    "expo-asset": "55.0.17",
    "expo-auth-session": "55.0.16",
    "expo-build-properties": "55.0.14",
    "expo-constants": "55.0.16",
    "expo-crypto": "55.0.15",
    "expo-dev-client": "55.0.35",
    "expo-device": "55.0.17",
    "expo-file-system": "55.0.22",
    "expo-font": "55.0.8",
    "expo-image": "55.0.11",
    "expo-linking": "55.0.15",
    "expo-localization": "55.0.15",
    "expo-secure-store": "55.0.14",
    "expo-splash-screen": "55.0.21",
    "expo-status-bar": "55.0.6",
    "expo-updates": "55.0.24",
    "expo-web-browser": "55.0.16",
    "i18n-js": "3.8.0",
    "install": "0.13.0",
    "lodash": "^4.18.1",
    "metro-core": "0.82.4",
    "metro-resolver": "0.82.4",
    "mobx": "6.13.7",
    "mobx-react": "9.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-get-random-values": "1.11.0",
    "react-native-modal": "14.0.0-rc.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "typescript": "5.9.3",
    "ulid": "3.0.1",
    "zod": "3.25.67"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
